{
  "name": "@study/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others \"tsx watch src/main.ts\" \"tsx watch src/worker.ts\"",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx src/infrastructure/db/migrate.ts",
    "db:seed:test": "tsx src/infrastructure/db/seed-test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1141.0",
    "@nestjs/common": "12.1.1",
    "@nestjs/core": "12.1.1",
    "@nestjs/platform-express": "12.1.1",
    "@study/contracts": "workspace:*",
    "argon2": "0.45.1",
    "busboy": "1.6.0",
    "mammoth": "1.10.0",
    "nodemailer": "10.0.8",
    "openai": "7.23.0",
    "pdfjs-dist": "6.3.289",
    "pg": "8.23.0",
    "pg-boss": "12.35.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/busboy": "1.5.4",
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "concurrently": "10.0.5",
    "tsx": "4.23.15"
  }
}
