{
  "name": "projeto-educacional",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @study/api --filter @study/web dev",
    "build": "pnpm -r build",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:contract": "vitest run --project contract",
    "test:e2e": "playwright test",
    "test:evaluations": "node tests/evaluations/run.mjs",
    "test:evaluations:score": "node tests/evaluations/score.mjs",
    "test:load": "k6 run tests/load/study.js",
    "db:migrate": "pnpm --filter @study/api db:migrate",
    "db:seed:test": "pnpm --filter @study/api db:seed:test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.36.0",
    "@playwright/test": "1.55.1",
    "@types/node": "24.6.2",
    "eslint": "9.36.0",
    "prettier": "3.6.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "3.2.4"
  }
}
